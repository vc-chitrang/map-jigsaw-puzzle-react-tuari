# Template for src-tauri/.env — the real file is gitignored and NEVER committed.
# Generate it with: npm run extract:api-config
#
# These values are read by the Rust side only. The renderer never sees the key:
# collection requests go through the `collection_fetch` command (Phase 3), so the
# key cannot be read from DevTools or a page script.

MAP_API_BASE_URL=
MAP_API_BASE_URL_DEV=
MAP_API_KEY=
MAP_API_LOGIN_PATH=oauth/token
MAP_API_COLLECTION_PATH=api/public_hook/v1/artwork
MAP_SOCKET_URL=https://i-am-puzzle.map-india.org
# Full URL the QR code encodes, before this kiosk's `?k=<token>` is appended.
# The path segment is a deliberately obfuscated value assigned by the upload
# server (its own UPLOAD_ROUTE_PATH) — there is no default, and no script can
# extract it from the Unity project the way the other values above are:
# this feature has no Unity-side equivalent. Get it from whoever owns the
# upload server's .env.
MAP_UPLOAD_URL=

# OAuth login (serialized on the LoginHandler component in the Unity scene,
# not in source). Only needed if the port reproduces the login boot step.
MAP_OAUTH_CLIENT_ID=
MAP_OAUTH_CLIENT_SECRET=
MAP_OAUTH_USERNAME=
MAP_OAUTH_PASSWORD=
